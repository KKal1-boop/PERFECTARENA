# Local portable toolchain (see docs/DECISIONS.md D8) — never part of the project.
.devtools/

# Scratch space for format reconnaissance dumps.
.scratch/

# Browser-test artifacts (regenerated on every run).
tests/shots/

# Dependencies and build output.
node_modules/
dist/

# Local Arena data copies (game data is never committed — it is read at runtime
# from the player's own Arena folder).
arena-local/
*.tmp
