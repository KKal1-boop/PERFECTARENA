{
  "name": "perfectarena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Elder Scrolls: Arena reimagined on the Daggerfall WebGL2 engine. Reads Arena's own data at runtime; bundles no game data.",
  "license": "MIT",
  "scripts": {
    "start": "node tools/launch.mjs",
    "dev": "node tools/serve.mjs 8080",
    "serve": "node tools/serve.mjs",
    "pack": "node tools/pack-cloud.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "probe:mif": "node tools/mif-dump.mjs",
    "probe:city": "node tools/city-dump.mjs --slots --ascii=60",
    "check": "npm run test && npm run test:browser"
  },
  "engines": {
    "node": ">=22.6"
  }
}
